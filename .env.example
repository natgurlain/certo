# Copy to .env. Never commit .env (it is in .gitignore).

# NEAR AI Cloud key, read by `make probe`, `make record`, `make killtest` and the testnet runner.
# Leave empty for replay mode.
NEARAI_API_KEY=

# ---- Testnet (only for `make testnet-demo` and scripts/deploy-testnet.ts; see docs/TESTNET.md)
# Check this file without sending anything: npx tsx scripts/deploy-testnet.ts --dry-run
NEAR_RPC_URL=https://rpc.testnet.fastnear.com
NEAR_EXPLORER_URL=https://testnet.nearblocks.io
# Keys are NEAR secret keys of the form ed25519:<base58>, one per account.
# Contract owner; its key is only needed to replace the juror keys later (set_jurors).
CERTO_OWNER=certo.testnet
CERTO_OWNER_PRIVATE_KEY=
CERTO_CONTRACT=v1.certo.testnet
CERTO_CONTRACT_PRIVATE_KEY=
CERTO_TOKEN=usdc.certo.testnet
CERTO_TOKEN_PRIVATE_KEY=
RESOLVER_ACCOUNT=resolver.certo.testnet
RESOLVER_PRIVATE_KEY=
SELLER_CHAINFACTS_ACCOUNT=chainfacts.sellers.certo.testnet
SELLER_CHAINFACTS_PRIVATE_KEY=
SELLER_CHEAPFACTS_ACCOUNT=cheapfacts.sellers.certo.testnet
SELLER_CHEAPFACTS_PRIVATE_KEY=
BUYER_SCOUT_ACCOUNT=scout.certo.testnet
BUYER_SCOUT_PRIVATE_KEY=
BUYER_SCOUT_LIAR_ACCOUNT=scout-liar.certo.testnet
BUYER_SCOUT_LIAR_PRIVATE_KEY=
# Juror keys on the testnet contract. Empty or `real`: the NEAR AI keys of fixtures/jurors.json.
# `synthetic`: the published TEST keys (anyone can sign rulings); required while fixtures/panel holds only synthetic ballots.
TESTNET_JURORS=
