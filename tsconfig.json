{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "tsBuildInfoFile": "./node_modules/.cache/tsc/tsconfig.tsbuildinfo"
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "packages/*/scripts",
    "apps/demo/*.ts",
    "apps/demo/src",
    "tests",
    "scripts"
  ]
}
